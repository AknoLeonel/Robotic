# API de Conversões da Meta (cadastre no painel da Vercel: Settings > Environment Variables)
# NUNCA coloque o token real neste arquivo nem em nenhum arquivo do repositório.
META_PIXEL_ID=1694579642232662
# Gerenciador de Eventos > arena robotica > Configurações > API de Conversões > Gerar token de acesso
META_CAPI_TOKEN=
# Versão da Graph API (confira a mais recente no Gerenciador de Eventos)
META_API_VERSION=v26.0
# Só durante o teste em "Eventos de teste"; apague depois
META_TEST_EVENT_CODE=
# Origens que podem enviar eventos
ALLOWED_ORIGINS=https://www.arenarobotica.com.br,https://arenarobotica.com.br
